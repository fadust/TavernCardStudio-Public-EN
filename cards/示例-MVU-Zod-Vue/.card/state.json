        "name": "示例-MVU-Zod-Vue",
        "entries": [
          {
            "id": 0,
            "keys": [],
            "secondary_keys": [],
            "comment": "[initvar]变量初始化勿开",
            "content": "{\n  \"场景\": { \"地点\": \"初始场景\", \"阶段\": \"开场\" },\n  \"角色\": { \"心情\": \"平静\", \"信任\": 0 }\n}\n",
            "constant": true,

  {
    "name": "Hide greeting initial variables (display)",
    "input": "First paragraph\n<initvar>{\"investigator\":{\"clearance\":\"Trainee\"}}</initvar>\nSecond paragraph",
    "expected": "First paragraph\n\nSecond paragraph"
  },
  {
    "name": "Remove greeting initial variables (prompt)",
    "input": "<initvar>{\"fogharbor\":{\"fogDensity\":25}}</initvar>\n\n<CardStatus/>",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVU 状态设计参考（不自动注册运行时校验）",
  "type": "object",
  "properties": {
    "场景": { "type": "object", "properties": { "地点": { "type": "string" }, "阶段": { "type": "string" } }, "required": ["地点", "阶段"], "additionalProperties": false },
    "角色": { "type": "object", "properties": { "心情": { "type": "string" }, "信任": { "type": "number", "minimum": 0, "maximum": 100 } }, "required": ["心情", "信任"], "additionalProperties": false }
  },
  "required": ["场景", "角色"],
  "additionalProperties": false
}

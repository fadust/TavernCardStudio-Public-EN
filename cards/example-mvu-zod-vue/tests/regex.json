    "input": "First paragraph\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"replace\",\"path\":\"/scene/location\",\"value\":\"Used bookshop\"}]</JSONPatch>\n</UpdateVariable>\nSecond paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nEnding",
    "expected": "First paragraph\n\nSecond paragraph\n\nEnding"

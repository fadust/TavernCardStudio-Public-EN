    "expected": "{{char}} is still writing.\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":3}]\n\n</details>"
  },
  {
    "name": "Fold incomplete variable updates (display, streaming)",
    "input": "First paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nSecond paragraph\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":1}]",
    "expected": "First paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nSecond paragraph\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":1}]\n\n</details>"
  },

{
  "dependencies": [
    {
      "url": "https://cdn.jsdelivr.net/gh/MagicalAstrogy/MagVarUpdate@3377b494cd7277230f3056230062124fe117f93f/artifact/bundle.js",
      "purpose": "Public MVU variable framework; requires Tavern Helper and enabled card scripts.",
      "version": "3377b494cd7277230f3056230062124fe117f93f"
    },
    {
      "url": "https://testingcf.jsdelivr.net/gh/StageDog/tavern_resource@69abb272d46bed4057a0dfb31758f6164cb7ecef/dist/util/mvu_zod.js",
      "purpose": "Official registerMvuSchema: registers the Zod schema from src/schema.ts with MVU and Tavern Helper's variable manager; imported from a pinned commit.",
      "version": "69abb272d46bed4057a0dfb31758f6164cb7ecef"
    }
  ],
  "scripts": [
    {
      "name": "MVU framework (pinned commit)",
      "source": "loader.js"
    },
    {
      "name": "Variable schema (Zod registration)",
      "source": "register-schema.js",
      "bundle": true
    }
  ],
  "worldbook": [
    {
      "comment": "[initvar]Initial variables - keep disabled",
      "keys": [],
      "constant": true,
      "enabled": false,
      "position": "before_char",
      "insertion_order": 90,
      "exclude_recursion": true,
      "prevent_recursion": true,
      "contentFile": "initvar.json"
    },
    {
      "comment": "Variable list",
      "keys": [],
      "constant": true,
      "position": "at_depth_as_system",
      "depth": 0,
      "insertion_order": 100,
      "exclude_recursion": true,
      "prevent_recursion": true,
      "contentFile": "variables.md"
    },
    {
      "comment": "[mvu_update]Variable update rules",
      "keys": [],
      "constant": true,
      "position": "at_depth_as_system",
      "depth": 0,
      "insertion_order": 101,
      "exclude_recursion": true,
      "prevent_recursion": true,
      "contentFile": "rules.md"
    },
    {
      "comment": "[mvu_update]Variable output format",
      "keys": [],
      "constant": true,
      "position": "at_depth_as_system",
      "depth": 0,
      "insertion_order": 102,
      "exclude_recursion": true,
      "prevent_recursion": true,
      "contentFile": "format.md"
    }
  ],
  "regex": [
    {
      "scriptName": "Fold variable updates (display)",
      "findRegex": "/<update(?:variable)?>\\s*([\\s\\S]*?)\\s*<\\/update(?:variable)?>/gi",
      "replacementFile": "regex/fold.txt",
      "placement": [
        "user_input",
        "ai_output"
      ],
      "markdownOnly": true,
      "promptOnly": false
    },
    {
      "scriptName": "Fold incomplete variable updates (display, streaming)",
      "findRegex": "/<update(?:variable)?>(?![\\s\\S]*<\\/update(?:variable)?>)\\s*([\\s\\S]*)$/gi",
      "replacementFile": "regex/fold.txt",
      "placement": [
        "user_input",
        "ai_output"
      ],
      "markdownOnly": true,
      "promptOnly": false
    },
    {
      "scriptName": "Remove variable updates (prompt)",
      "findRegex": "/<update(?:variable)?>[\\s\\S]*?<\\/update(?:variable)?>/gi",
      "replaceString": "",
      "placement": [
        "user_input",
        "ai_output"
      ],
      "markdownOnly": false,
      "promptOnly": true
    },
    {
      "scriptName": "Remove incomplete variable updates (prompt, streaming)",
      "findRegex": "/<update(?:variable)?>(?![\\s\\S]*<\\/update(?:variable)?>)[\\s\\S]*$/gi",
      "replaceString": "",
      "placement": [
        "user_input",
        "ai_output"
      ],
      "markdownOnly": false,
      "promptOnly": true
    }
  ],
  "fixtures": [
    {
      "name": "Fold variable updates (display)",
      "input": "{{char}} nods.\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"replace\",\"path\":\"/character/mood\",\"value\":\"Relaxed\"}]</JSONPatch>\n</UpdateVariable>",
      "expected": "{{char}} nods.\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"replace\",\"path\":\"/character/mood\",\"value\":\"Relaxed\"}]</JSONPatch>\n\n</details>"
    },
    {
      "name": "Fold variable updates (display)",
      "input": "First paragraph\n<UpdateVariable><JSONPatch>[{\"op\":\"remove\",\"path\":\"/character/mood\"}]</JSONPatch></UpdateVariable>\nSecond paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>",
      "expected": "First paragraph\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"remove\",\"path\":\"/character/mood\"}]</JSONPatch>\n\n</details>\nSecond paragraph\n<details><summary>Variable update</summary>\n\n<JSONPatch>[]</JSONPatch>\n\n</details>"
    },
    {
      "name": "Fold incomplete variable updates (display, streaming)",
      "input": "{{char}} is still writing.\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":3}]",
      "expected": "{{char}} is still writing.\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":3}]\n\n</details>"
    },
    {
      "name": "Fold incomplete variable updates (display, streaming)",
      "input": "First paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nSecond paragraph\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":1}]",
      "expected": "First paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nSecond paragraph\n<details><summary>Variable update</summary>\n\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":1}]\n\n</details>"
    },
    {
      "name": "Remove variable updates (prompt)",
      "input": "First paragraph\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"replace\",\"path\":\"/scene/location\",\"value\":\"Used bookshop\"}]</JSONPatch>\n</UpdateVariable>\nSecond paragraph\n<UpdateVariable><JSONPatch>[]</JSONPatch></UpdateVariable>\nEnding",
      "expected": "First paragraph\n\nSecond paragraph\n\nEnding"
    },
    {
      "name": "Remove incomplete variable updates (prompt, streaming)",
      "input": "First paragraph\n<UpdateVariable>\n<JSONPatch>[{\"op\":\"delta\",\"path\":\"/character/trust\",\"value\":2}]",
      "expected": "First paragraph\n"
    }
  ],
  "files": {
    "schema.ts": "src/schema.ts",
    "schema.json": "src/variables/schema.json"
  }
}
